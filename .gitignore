/data/
/.venv/
__pycache__/
*.pyc
*.log
.DS_Store
.claude/
.pytest_cache/

# The frozen tercile cuts are a PRE-REGISTRATION artifact: their entire value is
# that a commit proves they predate the data they are applied to. A frozen file
# that can be deleted and silently refitted is only weakly frozen, so this one
# specific file is tracked. Everything else under /data/ stays ignored.
# The parent directories must be unignored first or the negation cannot match.
!/data/
/data/*
!/data/derived/
/data/derived/*
!/data/derived/regime/
/data/derived/regime/*
!/data/derived/regime/terciles.json
# _manifest.json records row counts, per-column NaN counts, the config and the
# git hash -- what was produced, alongside terciles.json's what was frozen. Same
# provability argument, ~1.7 KB. The parquet outputs (9.8 MB) stay ignored.
!/data/derived/regime/_manifest.json
# The fold schedule is pre-registration-adjacent: §4.2's calendar rule is
# frozen, and a committed folds.json proves the boundaries were not moved
# after results were seen. ~4 KB.
!/data/derived/folds/
/data/derived/folds/*
!/data/derived/folds/folds.json
# grid.json records m*, the eleven multipliers, the derived cap and the A3
# verdict per fold per symbol -- all pre-lift, and the range is not
# extendable afterwards, so a committed copy proves it was not widened.
!/data/derived/sweep/
/data/derived/sweep/*
!/data/derived/sweep/grid.json
